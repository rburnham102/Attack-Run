[sub_resource type="Resource" id="brief_1"]
script = ExtResource("2_radio")
speaker = 1
text = "Our intel reports that the enemy is moving a large shipment by train."

[sub_resource type="Resource" id="brief_2"]
script = ExtResource("2_radio")
speaker = 1
text = "Our intel shows it may be armaments, but be careful."

[sub_resource type="Resource" id="warn_1"]
script = ExtResource("2_radio")
mood = 1
text = "Look out! There is a fortress ahead!"

[sub_resource type="Resource" id="down_1"]
script = ExtResource("2_radio")
text = "Great work, team! I think I see the train ahead."

[sub_resource type="Resource" id="warn_3"]
script = ExtResource("2_radio")
mood = 1
text = "Another train on the next track!"

[sub_resource type="Resource" id="end_1"]
script = ExtResource("2_radio")
mood = 1
text = "What was that!?"

[sub_resource type="Resource" id="end_2"]
script = ExtResource("2_radio")
speaker = 1
text = "It looks like they were transporting more than just weapons."

[sub_resource type="Resource" id="end_3"]
script = ExtResource("2_radio")
speaker = 1
text = "We need to see where these trains were heading."

[sub_resource type="Resource" id="end_4"]
script = ExtResource("2_radio")
mood = 2
text = "Right! Let's refuel, and we'll head right back out."

