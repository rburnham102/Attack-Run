[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/player_status.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/Bomber/BONUS Bomber Mini.png" id="2_plane"]

[sub_resource type="AtlasTexture" id="plane_icon"]
atlas = ExtResource("2_plane")
region = Rect2(64, 37, 160, 118)

[sub_resource type="StyleBoxFlat" id="special_bg"]
bg_color = Color(0, 0, 0, 0.6)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0, 0, 0, 1)

[sub_resource type="StyleBoxFlat" id="special_fill"]
bg_color = Color(1, 0.8, 0.2, 1)

[node name="PlayerStatus" type="VBoxContainer"]
theme_override_constants/separation = 4
script = ExtResource("1_script")
life_icon = SubResource("plane_icon")

[node name="Lives" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Health" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 3

[node name="SpecialBar" type="ProgressBar" parent="."]
custom_minimum_size = Vector2(150, 12)
layout_mode = 2
theme_override_styles/background = SubResource("special_bg")
theme_override_styles/fill = SubResource("special_fill")
max_value = 1.0
step = 0.0
show_percentage = false
